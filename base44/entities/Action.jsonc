{
  "name": "Action",
  "type": "object",
  "properties": {
    "ncId": {
      "type": "string",
      "description": "ID de la NC parente"
    },
    "initiateurEmail": {
      "type": "string",
      "description": "Email de l'initiateur de la NC parente (pour le partage en lecture \u00e0 l'initiateur)"
    },
    "responsablesProcessus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails des responsables du processus assign\u00e9 de la NC parente, copi\u00e9s \u00e0 la cr\u00e9ation de l'action (acc\u00e8s pilotage : cr\u00e9ation, lecture, mise \u00e0 jour pour le responsable du processus)"
    },
    "description": {
      "type": "string",
      "description": "Titre / description de l'action corrective"
    },
    "responsable": {
      "type": "string",
      "description": "Processus responsable de l'action"
    },
    "responsableNom": {
      "type": "string",
      "description": "Nom du responsable"
    },
    "dateFinPrevue": {
      "type": "string",
      "format": "date",
      "description": "Date d'\u00e9ch\u00e9ance pr\u00e9vue"
    },
    "dateRealisationEffective": {
      "type": "string",
      "format": "date",
      "description": "Date de r\u00e9alisation effective"
    },
    "statut": {
      "type": "string",
      "enum": [
        "\u00c0 faire",
        "En cours",
        "En v\u00e9rification",
        "Termin\u00e9",
        "R\u00e9alis\u00e9e",
        "En retard"
      ],
      "default": "\u00c0 faire",
      "description": "Statut de l'action (les valeurs 'R\u00e9alis\u00e9e' et 'En retard' sont conserv\u00e9es pour les donn\u00e9es historiques)"
    },
    "historique": {
      "type": "array",
      "description": "Historique des changements de statut et d'assignation (lecture seule, preuve d'audit)",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "description": "Date et heure du changement (ISO)"
          },
          "ancienStatut": {
            "type": "string",
            "description": "Statut avant le changement"
          },
          "nouveauStatut": {
            "type": "string",
            "description": "Statut apr\u00e8s le changement"
          },
          "auteurEmail": {
            "type": "string",
            "description": "Email de l'auteur du changement"
          },
          "auteurNom": {
            "type": "string",
            "description": "Nom de l'auteur du changement"
          },
          "type": {
            "type": "string",
            "description": "Type d'entr\u00e9e d'historique (ex: 'assignation' ; vide pour un changement de statut)"
          },
          "ancienAssigne": {
            "type": "string",
            "description": "Email du membre assign\u00e9 avant le changement d'assignation"
          },
          "nouvelAssigne": {
            "type": "string",
            "description": "Email du membre assign\u00e9 apr\u00e8s le changement d'assignation"
          }
        }
      }
    },
    "commentaireRealisation": {
      "type": "string",
      "description": "Commentaire de r\u00e9alisation"
    },
    "piecesJustificatives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL du fichier upload\u00e9"
          },
          "nom": {
            "type": "string",
            "description": "Nom original du fichier"
          }
        },
        "required": [
          "url"
        ]
      },
      "description": "Pi\u00e8ces justificatives (url + nom ; anciens \u00e9l\u00e9ments au format string URL restent accept\u00e9s \u00e0 l'affichage)"
    },
    "retardNotifie": {
      "type": "boolean",
      "default": false,
      "description": "Indique que le retard de cette action a d\u00e9j\u00e0 donn\u00e9 lieu \u00e0 une notification HSE (garde anti-spam du scan quotidien)"
    },
    "rappelPreventifNotifie": {
      "type": "boolean",
      "default": false,
      "description": "Indique que le rappel pr\u00e9ventif d'\u00e9ch\u00e9ance (J-3) a d\u00e9j\u00e0 \u00e9t\u00e9 envoy\u00e9 pour cette action (garde anti-spam du scan quotidien ; remis \u00e0 false si l'\u00e9ch\u00e9ance est modifi\u00e9e)"
    },
    "assigneEmail": {
      "type": "string",
      "description": "Email du membre d'\u00e9quipe individuellement assign\u00e9 \u00e0 l'action (sous-assignation par le pilote, optionnelle)"
    },
    "assigneNom": {
      "type": "string",
      "description": "Nom d'affichage du membre assign\u00e9"
    },
    "dateAssignation": {
      "type": "string",
      "format": "date",
      "description": "Date \u00e0 laquelle le pilote a fait la sous-assignation"
    },
    "retardAssigneNotifie": {
      "type": "boolean",
      "default": false,
      "description": "Indique que la relance de retard a d\u00e9j\u00e0 \u00e9t\u00e9 envoy\u00e9e individuellement au membre assign\u00e9 (garde anti-spam distincte de retardNotifie)"
    }
  },
  "required": [
    "ncId",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "qhse"
          }
        },
        {
          "data.responsablesProcessus": {
            "$in": [
              "{{user.email}}"
            ]
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.initiateurEmail": "{{user.email}}"
        },
        {
          "data.responsable": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.responsablesProcessus": "{{user.email}}"
        },
        {
          "data.assigneEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "qhse"
          }
        },
        {
          "user_condition": {
            "role": "direction"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.responsable": "{{user.email}}"
        },
        {
          "data.responsablesProcessus": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "data.assigneEmail": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "qhse"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "qhse"
      }
    }
  }
}